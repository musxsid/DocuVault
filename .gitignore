# =============================================================================
# DocuVault — Professional Git Ignore Specification
# =============================================================================

# Environment, Secrets & Local Credentials (CRITICAL)
.env
*.env
.env.*
!.env.example
config/api_keys.json
config/session.enc

# Local Databases, Keys & File Operations
vault/keys/
vault/users.db
*.db
*.sqlite
*.sqlite3

# Runtime Dynamic Plots & Visualizations (Keep directory structure)
vault/plots/*
!vault/plots/.gitkeep
vault/intake/*
!vault/intake/.gitkeep
vault/quarantine/*
!vault/quarantine/.gitkeep
vault/local/
vault/archive/
vault/cloud_mirror/

# Runtime User State & Monitoring Indices (Clean on clone)
config/tracked_files_index.json
config/chat_history.json
config/watched_folders.json

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Logs, Runtime & Diagnostic Files
*.log
file_ops.log
scratch/
tmp/
temp/
.tempmediaStorage/

# Operating System & IDE Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
