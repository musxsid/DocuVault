# =============================================================================
# DocuVault — Environment Variables Template
# Copy this file to .env and configure your local or cloud environment values.
# =============================================================================

# --- LLM Provider Configuration ---
# Optional: Set your Groq API key for cloud LLM query synthesis & fast fallback.
# When omitted, DocuVault operates in 100% air-gapped local TF-IDF vector retrieval mode.
GROQ_API_KEY=your_groq_api_key_here
PREFERRED_PROVIDER=groq

# --- Keycloak OIDC Authentication (Optional / Enterprise SSO) ---
# DocuVault includes an air-gapped local PBKDF2 authentication fallback.
# If integrating with an enterprise Keycloak server:
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=docuvault
KEYCLOAK_CLIENT_ID=docuvault-desktop
KEYCLOAK_CLIENT_SECRET=

# --- Google OAuth2 SSO (Optional) ---
# Local redirect callback runs at http://localhost:8088/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MongoDB Persistence (Optional) ---
# When MongoDB is unavailable, DocuVault gracefully degrades to in-memory/JSON caching.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=docuvault

# --- Server Ports ---
FLASK_PORT=5000
STREAMLIT_PORT=8501
